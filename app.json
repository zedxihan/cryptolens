{
  "expo": {
    "name": "CryptoLens",
    "slug": "cryptolens",
    "version": "0.3.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cryptolens",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zedxihan.cryptolens"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#060c0a"
      },
      "package": "com.zedxihan.cryptolens",
      "versionCode": 4,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#060c0a",
          "dark": {
            "backgroundColor": "#060c0a"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "./plugins/withSeparateBuilds",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "usePrecompiledHeaders": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a785b78-ed20-4fea-9d2a-f17dc0e3770f"
      }
    },
    "owner": "cryptolens-org",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8a785b78-ed20-4fea-9d2a-f17dc0e3770f"
    }
  }
}
